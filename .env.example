# === REQUIRED: Security Secrets ===
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
POS_LICENSE_SECRET=CHANGE_ME_generate_random_64_char_hex
POS_AUTH_SECRET=CHANGE_ME_generate_random_64_char_hex

# === OPTIONAL: CORS Origins (comma-separated) ===
# Leave empty to allow all origins (development only!)
# Example: https://pos.example.com,https://admin.example.com
POS_CORS_ORIGINS=

# === OPTIONAL: Database Encryption Key ===
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POS_ENCRYPTION_KEY=
